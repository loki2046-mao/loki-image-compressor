{
  "name": "loki-compress-stats",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loki-compress-stats",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "6110601",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "30 17 * * *"
    ]
  }
}
